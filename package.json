{
  "name": "editorial-wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "validate": "node scripts/validate.js",
    "admin:setup": "node scripts/admin-setup.js",
    "test": "node --test --test-isolation=none",
    "test:browser": "node scripts/browser-check.js",
    "data:export": "node --env-file-if-exists=.env scripts/data.js export",
    "data:backup": "node --env-file-if-exists=.env scripts/data.js backup",
    "data:import": "node --env-file-if-exists=.env scripts/data.js import"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
